# ===== Supabase (Project Settings > API) =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# رابط الموقع بعد الرفع (مثال: https://meplab.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== بيانات الدفع اللي بتظهر للطالب =====
NEXT_PUBLIC_INSTAPAY_HANDLE=yourname@instapay
NEXT_PUBLIC_VODAFONE_CASH_NUMBER=010XXXXXXXX

# ===== التواصل =====
# رقم واتساب بالصيغة الدولية من غير + (مثال: 2010XXXXXXXX)
NEXT_PUBLIC_WHATSAPP=2010XXXXXXXX
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/MEPLAB.EGY
NEXT_PUBLIC_MESSENGER_URL=https://m.me/MEPLAB.EGY

# رابط تحميل MEP LAB Player (GitHub Release أو Google Drive)
NEXT_PUBLIC_PLAYER_DOWNLOAD_URL=https://github.com/YOUR/REPO/releases/latest
NEXT_PUBLIC_PLAYER_VERSION=1.3.0

# ===== سر توليد أكواد التفعيل (سيرفر فقط - ما يتنشرش أبدًا) =====
# اعمل قيمة عشوائية طويلة. لازم تكون نفس القيمة اللي البرنامج بيتحقق بيها.
LICENSE_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-SECRET

# ===== قسم الوظايف (أوتوماتيك) =====
# مفتاح Jooble المجاني: https://jooble.org/api/about
JOOBLE_API_KEY=
# اختياري — JSearch على RapidAPI (خطة مجانية محدودة)
RAPIDAPI_KEY=
# مفتاح السيرفر من Supabase (Project Settings > API > service_role) — سري
SUPABASE_SERVICE_ROLE_KEY=
# أي قيمة عشوائية طويلة — Vercel بيستخدمها لتشغيل التحديث اليومي
CRON_SECRET=

# ===== تقييم الـ CV بالذكاء الاصطناعي (Gemini) =====
# مفتاح مجاني من https://aistudio.google.com/apikey
GEMINI_API_KEY=
# اسم الموديل (لو جوجل غيّرت الأسماء عدّله هنا)
GEMINI_MODEL=gemini-flash-latest
# عدد التقييمات المسموحة لكل حساب في اليوم
AI_DAILY_LIMIT=3

# ===== أدوات مجانية =====
# لينك تحميل AT Tools (لو اتغيّر)
NEXT_PUBLIC_AT_TOOLS_URL=https://drive.google.com/file/d/1HzkViwOkHqFcjvjcHibVJ9kZIWUVbRw0/view?usp=sharing

# ===== إشعارات الإيميل (اختياري) — https://resend.com (مجاني 3000 إيميل/شهر) =====
RESEND_API_KEY=
# لازم يكون من دومين متحقق منه في Resend (مثال: MEP LAB <noreply@meplab.net>)
EMAIL_FROM=MEP LAB <onboarding@resend.dev>
# الإيميل اللي يوصله إشعار بكل طلب جديد
ADMIN_EMAIL=
# موديل احتياطي لو الأساسي عليه ضغط
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
